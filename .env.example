HF_TOKEN=

# --- OpenAI / LLM (for question generation and prediction) ---
# Required ONLY when an OpenAI-backed connector is selected (the default for
# both PREDICTOR_BACKEND and QUESTION_GENERATOR_BACKEND — see "Backend
# selection" below). At least one of these must be set in that case.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# SKIP_GENERATOR=true  # legacy flag — set to skip LLM question generation (predictor still required)

# --- Database ---
# DATABASE_URL=postgresql://prescreen:prescreen@localhost:5432/prescreen
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=prescreen
# PG_PASSWORD=prescreen
# PG_DATABASE=prescreen
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=10

# --- Server ---
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# SERVER_CORS_ORIGINS=*
# SERVER_RULESET_DIR=
# SERVER_LOG_LEVEL=INFO
# SESSION_TTL_DAYS=0
# ADMIN_API_KEY=
# TRUSTED_PROXY_SECRET=

# --- Medical / Domain thresholds ---
PEDIATRIC_AGE_THRESHOLD=15
DEFAULT_ER_SEVERITY=sev003
DEFAULT_ER_DEPARTMENT=dept002

# --- Pagination ---
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# --- Cleanup ---
DEFAULT_CLEANUP_DAYS=90

# --- vLLM predictor (MedgemmaPredictionModule) ---
# Used when PREDICTOR_BACKEND=medgemma. VLLM_PREDICTOR_URL is the full
# chat-completions endpoint (used as-is). VLLM_PREDICTOR_MODEL defaults to
# google/medgemma-27b-text-it when empty. VLLM_APIKEY may be left empty —
# self-hosted vLLM typically runs without auth, in which case no
# Authorization header is sent.
# VLLM_PREDICTOR_URL=http://host:port/v1/chat/completions
# VLLM_PREDICTOR_MODEL=google/medgemma-27b-text-it
# VLLM_APIKEY=

# --- Backend selection ---
# PREDICTOR_BACKEND is never null (defaults to openai). Valid: openai | medgemma.
# QUESTION_GENERATOR_BACKEND may be null: an empty value disables LLM question
# generation entirely. An unset variable defaults to openai. Valid: openai.
PREDICTOR_BACKEND=openai
QUESTION_GENERATOR_BACKEND=openai
